# Скопируйте этот файл в .env и заполните значения.
# Если OPENAI_API_KEY не указан, сайт работает в режиме по шаблону.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ВКонтакте
# VK_ACCESS_TOKEN — токен доступа сообщества с правом публикации на стене.
# VK_GROUP_ID — числовой ID сообщества (без минуса и без club/).
VK_ACCESS_TOKEN=
VK_GROUP_ID=
